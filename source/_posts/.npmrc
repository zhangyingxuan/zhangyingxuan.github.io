# =============================================================================
# 1. 基础镜像源配置 (Base Registry)
# =============================================================================
# 默认走阿里云维护的淘宝镜像源，解决国内访问 npmjs.org 慢的问题
registry=https://registry.npmmirror.com/

# =============================================================================
# 2. 严谨性与依赖悬挂控制 (Strictness & Resolution)
# =============================================================================
# 开启后，如果 lock 文件与 package.json 不一致，直接报错，防止团队成员乱改依赖
frozen-lockfile=false

# 幽灵依赖控制：设置为 false 可以严格隔离非声明依赖（pnpm 默认行为，建议保持）
hoist=false

# =============================================================================
# 3. 原生 C++ 模块与二进制文件加速 (Binary Mirrors)
# =============================================================================
# 很多库在 install 时会去 GitHub 下载预编译的二进制文件，这里强制重定向到国内镜像
sass_binary_site=https://npmmirror.com/mirrors/node-sass/
sharp_binary_host=https://npmmirror.com/mirrors/sharp/
electron_mirror=https://npmmirror.com/mirrors/electron/
canvas_binary_host_mirror=https://npmmirror.com/mirrors/node-canvas-prebuilt/
node_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/sqlite3/
profiler_binary_host_mirror=https://npmmirror.com/mirrors/node-inspector/
puppeteer_download_host=https://npmmirror.com/mirrors/

# =============================================================================
# 4. 兼容性与网络容错 (Compatibility & Network)
# =============================================================================
# 提高网络超时时间到 2 分钟，防止大包下载时因为网络波动断连
fetch-timeout=120000
# 失败重试次数
fetch-retries=3